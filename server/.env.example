# ===================================================
# Backend Environment Configuration (Express + Prisma)
# ===================================================

# Host and Port Configuration
# (On Render, PORT is automatically injected; HOST defaults to 0.0.0.0)
HOST=0.0.0.0
PORT=5000
NODE_ENV=production

# Allowed Frontend Client URLs for CORS (comma-separated if multiple)
# Production: Your Vercel domain (e.g. https://monisha-portfolio.vercel.app)
# Local: http://localhost:5173
CLIENT_URL=https://monisha-portfolio.vercel.app,http://localhost:5173

# Neon Cloud PostgreSQL Connection Strings
# (Pooled URL: Used for application queries and high concurrency)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# (Direct / Unpooled URL: Used for Prisma schema migrations)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Sheets Contact Storage Configuration
# The ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Sheet1

# ===================================================
# Google Service Account Credentials (Choose ONE method)
# ===================================================

# Option 1 (Recommended on Render): Render Secret File
# In Render Dashboard: "Secret Files" -> Add filename `google-credentials.json` -> Paste JSON contents
# Render mounts it at /etc/secrets/google-credentials.json (automatically detected)

# Option 2: Full JSON string in environment variable
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'

# Option 3: Individual environment variables
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 4 (Local development): Relative or absolute path to local credentials JSON file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=google-credentials.json
